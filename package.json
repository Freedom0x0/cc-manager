{
  "name": "cc-manager",
  "version": "0.3.0",
  "description": "本地管理 Claude Code 会话历史:查看、搜索、继续会话",
  "author": "Freedom0x0",
  "license": "MIT",
  "homepage": "https://github.com/Freedom0x0/cc-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/Freedom0x0/cc-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Freedom0x0/cc-manager/issues"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare:sidecar:release": "node scripts/prepare-sidecar.mjs --release",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .",
    "dev:tauri": "tauri dev",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "build:vite": "vite build",
    "build:tauri": "tauri build",
    "tauri": "tauri",
    "test": "npm run typecheck && npm run test:tauri",
    "test:legacy-electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx --test tests/db.test.ts tests/parser.test.ts tests/importer.test.ts tests/projects-repo.test.ts tests/sessions-repo.test.ts tests/search.test.ts tests/tree.test.ts tests/resumer.test.ts tests/template.test.ts tests/watcher.test.ts tests/mcp.test.ts tests/skills.test.ts tests/commands.test.ts tests/sub-agents.test.ts tests/hooks.test.ts tests/plugins.test.ts tests/profiles.test.ts tests/usage.test.ts tests/settings-writer.test.ts tests/migration.test.ts",
    "test:tauri": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "typecheck": "tsc --noEmit",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "antd": "^6.5.2",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
